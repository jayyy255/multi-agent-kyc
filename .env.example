# Application Configuration
APP_NAME=multi-agent-kyc-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security (Optional API Key for Power Automate / Gateway authentication)
API_KEY=kyc-dev-secret-key-change-in-prod
REQUIRE_API_KEY=false

# Logging
LOG_LEVEL=INFO
MASK_PII_LOGS=true

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=*
